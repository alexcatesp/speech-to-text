<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SpeechToText</AssemblyName>
    <RootNamespace>SpeechToText</RootNamespace>
    <Version>1.2.0</Version>
    <!-- Publicación portable: dotnet publish -c Release -r win-x64 -p:PublishPortable=true -->
    <SelfContained Condition="'$(PublishPortable)' == 'true'">true</SelfContained>
    <PublishSingleFile Condition="'$(PublishPortable)' == 'true'">true</PublishSingleFile>
    <EnableCompressionInSingleFile Condition="'$(PublishPortable)' == 'true'">true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(PublishPortable)' == 'true'">true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
